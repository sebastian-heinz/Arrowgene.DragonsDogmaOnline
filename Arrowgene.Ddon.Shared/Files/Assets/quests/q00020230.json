                    "result_commands": [
                        {"type": "PlayMessage", "Param1": 15882, "Param2": 10, "comment": "Black Knight: Annoying, worthless bugs..."},
                        {"type": "PlayMessage", "Param1": 15891, "Param2": 10, "comment": "Cecily: Release Loeg!"},
                        {"type": "PlayMessage", "Param1": 15900, "Param2": 10, "comment": "Gurdolin: What is your true identity!"},
                        {"type": "PlayMessage", "Param1": 15883, "Param2": 10, "comment": "Black Knight: You should lament being in my world."},
                        {"type": "PlayMessage", "Param1": 15892, "Param2": 10, "comment": "Cecily: Everyone, be careful!"},
                        {"type": "PlayMessage", "Param1": 15884, "Param2": 10, "comment": "Black Knight: The order of the strong does not require the weak."},
                        {"type": "PlayMessage", "Param1": 15901, "Param2": 10, "comment": "Gurdolin: You smoky bastard!"},
                        {"type": "PlayMessage", "Param1": 15893, "Param2": 10, "comment": "Cecily: Taaa—!"},
                        {"type": "PlayMessage", "Param1": 15906, "Param2": 10, "comment": "Elliot: I want Master Joseph to witness this valiant form!"},
                        {"type": "PlayMessage", "Param1": 15912, "Param2": 10, "comment": "Lise: I despise your persistence!"},
                        {"type": "PlayMessage", "Param1": 15894, "Param2": 10, "comment": "Cecily: Ser Gurdolin, Elliot, Lise,and Captain..."},
                        {"type": "PlayMessage", "Param1": 15885, "Param2": 10, "comment": "Black Knight: Be martyred in service to the fallen dragon."},
                        {"type": "PlayMessage", "Param1": 15895, "Param2": 10, "comment": "Cecily: Everyone, please survive..."},
                        {"type": "PlayMessage", "Param1": 15902, "Param2": 10, "comment": "Gurdolin: You dare call yourself a knight?"},
                        {"type": "PlayMessage", "Param1": 15907, "Param2": 10, "comment": "Elliot: I won't lose! I absolutely will not lose!"},
                        {"type": "PlayMessage", "Param1": 15913, "Param2": 10, "comment": "Lise: I'm not afraid of such attacks!"},
                        {"type": "PlayMessage", "Param1": 15886, "Param2": 10, "comment": "Black Knight: You are nothing but detritus in this great realm."},
                        {"type": "PlayMessage", "Param1": 15896, "Param2": 10, "comment": "Cecily: Aaaaahhh!"},
                        {"type": "PlayMessage", "Param1": 15903, "Param2": 10, "comment": "Gurdolin: Hey, Captain! Tell him what for!"},
                        {"type": "PlayMessage", "Param1": 15914, "Param2": 10, "comment": "Lise: This is where we dig in our heels!"},
                        {"type": "PlayMessage", "Param1": 15908, "Param2": 10, "comment": "Elliot: I'm pretty capable, aren't I?"},
                        {"type": "PlayMessage", "Param1": 15887, "Param2": 10, "comment": "Black Knight: Did you think you could win..."},
                        {"type": "PlayMessage", "Param1": 15897, "Param2": 10, "comment": "Cecily: Loeg! Come to your senses!"},
                        {"type": "PlayMessage", "Param1": 15909, "Param2": 10, "comment": "Elliot: Black Knight? Loeg? Who are you fighting against!?"},
                        {"type": "PlayMessage", "Param1": 15915, "Param2": 10, "comment": "Lise: Right now, I may be at the peak of my Arisen life!"},
                        {"type": "PlayMessage", "Param1": 15888, "Param2": 10, "comment": "Black Knight: I didn't expect you to persist this much... Crushing you will be worth my time."},
                        {"type": "PlayMessage", "Param1": 15898, "Param2": 10, "comment": "Cecily: The shadows of Phindym will not be harbored by evil!"},
                        {"type": "PlayMessage", "Param1": 15904, "Param2": 10, "comment": "Gurdolin: You guys bet all your money my loss!"},
                        {"type": "PlayMessage", "Param1": 15916, "Param2": 10, "comment": "Lise: Aren't I shining brightly?"},
                        {"type": "PlayMessage", "Param1": 15889, "Param2": 10, "comment": "Black Knight: Death is ever present beside you."},
                        {"type": "PlayMessage", "Param1": 15899, "Param2": 10, "comment": "Cecily: You coward who lurks in the shadows! Leave this place at once!"},
                        {"type": "PlayMessage", "Param1": 15911, "Param2": 10, "comment": "Elliot: Loeg, don't you recognize me?!"},
                        {"type": "PlayMessage", "Param1": 15905, "Param2": 10, "comment": "Gurdolin: I'm exhausted... give me a break!"},
                        {"type": "PlayMessage", "Param1": 15917, "Param2": 10, "comment": "Lise: I can do it!"},
                        {"type": "PlayMessage", "Param1": 15890, "Param2": 10, "comment": "Black Knight: You half-hearted Arisen... how insolent!"}
