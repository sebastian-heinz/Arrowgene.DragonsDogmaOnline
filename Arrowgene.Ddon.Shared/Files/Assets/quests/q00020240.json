                        {"type": "PlayMessage", "Param1": 15981, "Param2": 10, "comment": "Gurdolin: Elliot, get a move on!"},
                        {"type": "PlayMessage", "Param1": 15972, "Param2": 10, "comment": "Cecily: Hyah!"},
                        {"type": "PlayMessage", "Param1": 15985, "Param2": 10, "comment": "Lise: Turn quick and attack! Swiftly! As fast as I am!"},
                        {"type": "PlayMessage", "Param1": 15973, "Param2": 10, "comment": "Cecily: Let's do it in waves!"},
                        {"type": "PlayMessage", "Param1": 15993, "Param2": 10, "comment": "Elliot: Hah—hah... that's tough."},
                        {"type": "PlayMessage", "Param1": 15986, "Param2": 10, "comment": "Lise: My stamina is running out! This might not end well!"},
                        {"type": "PlayMessage", "Param1": 15974, "Param2": 10, "comment": "Cecily: Everyone... good luck."},
                        {"type": "PlayMessage", "Param1": 15992, "Param2": 10, "comment": "Elliot: Captain, let's decide this once and for all!"},
                        {"type": "PlayMessage", "Param1": 15982, "Param2": 10, "comment": "Gurdolin: A Dragon is a Dragon no matter what the circumstance... they're tough."},
                        {"type": "PlayMessage", "Param1": 15987, "Param2": 10, "comment": "Lise: We've come this far! We will see it through to the end!"},
