                        {"type": "PlayMessage", "Param1": 15977, "Param2": 10, "comment": "Gurdolin: I won't hold back!"},
                        {"type": "PlayMessage", "Param1": 15989, "Param2": 10, "comment": "Elliot: Forgive me, Spirit Dragon!"},
                        {"type": "PlayMessage", "Param1": 15983, "Param2": 10, "comment": "Lise: Jump high and attack! How about this!?"},
                        {"type": "PlayMessage", "Param1": 15967, "Param2": 10, "comment": "Cecily: Sleep now... And settle into a quiet slumber..."},
                        {"type": "PlayMessage", "Param1": 15990, "Param2": 10, "comment": "Elliot: Even when it is ill, a Dragon is truly formidable, isn't it?"},
                        {"type": "PlayMessage", "Param1": 15978, "Param2": 10, "comment": "Gurdolin: Hey, you know holding back is disrespectful, right?"},
                        {"type": "PlayMessage", "Param1": 15968, "Param2": 10, "comment": "Cecily: Be still, O Spirit Dragon!"},
                        {"type": "PlayMessage", "Param1": 15984, "Param2": 10, "comment": "Lise: Run low and attack! How's that?"},
                        {"type": "PlayMessage", "Param1": 15979, "Param2": 10, "comment": "Gurdolin: Lise, you're holding back!"},
                        {"type": "PlayMessage", "Param1": 15991, "Param2": 10, "comment": "Elliot: I won't run away, I will not flee!"},
